<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TutorSpace</RootNamespace>
    <AssemblyName>TutorSpace</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>UI\app.ico</ApplicationIcon>

    <Product>TutorSpace</Product>
    <Title>TutorSpace</Title>
    <Description>Недельное расписание заданий для преподавателя и ученика</Description>
    <Version>1.0.0</Version>
    <Copyright>© 2026 TutorSpace</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <!-- Only Russian and English resource satellites go into the release. -->
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
  </ItemGroup>

  <!-- Documentation, demo page and screenshots are not part of the program. -->
  <ItemGroup>
    <None Remove="Демо\**;Выпуск\**;Скриншоты\**" />
  </ItemGroup>

</Project>
