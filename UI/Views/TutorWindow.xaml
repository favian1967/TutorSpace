<Window x:Class="TutorSpace.UI.Views.TutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorSpace — преподаватель" Width="1360" Height="860" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,20,26">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Primary}">
                        <TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" Foreground="White" FontSize="16" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TutorSpace" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0" Click="ChangePassword_Click" AutomationProperties.Name="Сменить пароль">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE72E;" />
                            <TextBlock Text="Сменить пароль" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0" Click="Logout_Click" AutomationProperties.Name="Выйти">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7E8;" />
                            <TextBlock Text="Выйти" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="4,14,4,0">
                        <DockPanel>
                            <Border x:Name="AvatarHost" DockPanel.Dock="Left" Margin="0,0,10,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Преподаватель" Foreground="{StaticResource TextMuted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="Nav" Style="{StaticResource NavList}" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="students" AutomationProperties.Name="Ученики">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE716;" /><TextBlock Text="Ученики" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="templates" AutomationProperties.Name="Шаблоны недель">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8A5;" /><TextBlock Text="Шаблоны недель" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="sandbox" AutomationProperties.Name="Песочница">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE943;" /><TextBlock Text="Песочница" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="library" AutomationProperties.Name="Аудиотека">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE8D6;" /><TextBlock Text="Аудиотека" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="wordofday" AutomationProperties.Name="Слово дня">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavIcon}" Text="&#xE734;" /><TextBlock Text="Слово дня" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <ContentControl x:Name="Host" Grid.Column="1" />
    </Grid>
</Window>
