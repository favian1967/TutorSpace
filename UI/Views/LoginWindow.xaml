<Window x:Class="TutorSpace.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TutorSpace — вход" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource {x:Type Window}}">
    <StackPanel Margin="32,32,32,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Primary}">
                <TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" Foreground="White" FontSize="20" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="TutorSpace" FontSize="24" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,20"
                   Text="Недельное расписание заданий для преподавателя и ученика." />

        <!-- Login -->
        <Border x:Name="LoginPanel" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Вход" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Логин" />
                <TextBox x:Name="LoginBox" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль" />
                <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />
                <Button Style="{StaticResource PrimaryButton}" Content="Войти" Margin="0,20,0,0" MinHeight="40"
                        HorizontalAlignment="Stretch" Click="Login_Click" IsDefault="True" />
                <Button Style="{StaticResource LinkButton}" Content="Зарегистрировать преподавателя"
                        Margin="0,12,0,0" HorizontalAlignment="Left" Click="ShowRegister_Click" />
            </StackPanel>
        </Border>

        <!-- Register tutor -->
        <Border x:Name="RegisterPanel" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="RegisterTitle" Style="{StaticResource H2}" Text="Новый преподаватель" />
                <TextBlock Style="{StaticResource Muted}" Text="Учеников потом добавляет сам преподаватель в разделе «Ученики»." />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Имя (как показывать)" />
                <TextBox x:Name="RegNameBox" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Логин" />
                <TextBox x:Name="RegLoginBox" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль" />
                <PasswordBox x:Name="RegPasswordBox" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль ещё раз" />
                <PasswordBox x:Name="RegPassword2Box" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Создать и войти" Click="Register_Click" />
                    <Button x:Name="BackButton" Content="Назад" Click="Back_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
        <Button Style="{StaticResource LinkButton}" Content="Настройки подключения к БД" FontSize="12"
                Margin="0,6,0,0" HorizontalAlignment="Left" Click="DbSettings_Click" />
    </StackPanel>
</Window>
